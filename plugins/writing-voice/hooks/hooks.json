{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"${CLAUDE_PLUGIN_ROOT}/scripts/check_markdown_writing.py\"",
            "timeout": 15,
            "statusMessage": "Checking the markdown against the writing voice..."
          }
        ]
      }
    ]
  }
}
