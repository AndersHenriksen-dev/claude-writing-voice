      "may",
      "might",
      "maybe",
      "perhaps",
      "probably",
      "usually",
      "often",
      "sometimes",
      "seem",
      "seems",
      "seemed",
      "quite",
      "rather",
      "basically",
      "approximately",
      "potentially",
      "tend",
      "tends",
      "guess",
      "think",
      "somewhat",
      "depends",
      "generally"
